+.aito-viewport{position:relative;flex:1;min-height:100px;background:var(--surface)}.aito-placeholder{height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px;color:var(--text-secondary)}
+.aito-footer{padding:8px 18px;flex-shrink:0;border-top:1px solid var(--border)}.aito-notice{padding:10px 16px;background:color-mix(in srgb,#d97706 12%,var(--surface));border:1px solid color-mix(in srgb,#d97706 30%,var(--border));border-radius:8px;margin:8px 12px;font-size:13px;overflow-wrap:anywhere}
