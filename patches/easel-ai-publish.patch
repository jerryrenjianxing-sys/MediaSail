+.aito-modal-overlay{z-index:2500}.aito-compose{width:min(900px,95vw);max-height:92vh;display:flex;flex-direction:column;background:var(--surface);color:var(--text-primary);border:1px solid var(--border);border-radius:16px;box-shadow:0 20px 70px #0003;overflow:hidden}
+.aito-compose>header{display:flex;justify-content:space-between;align-items:flex-start;padding:20px 24px;border-bottom:1px solid var(--border)}.aito-compose h2{font-size:20px;margin:0 0 7px}.aito-compose header p{font-size:13px;color:var(--text-secondary);margin:0}.aito-compose-body{padding:18px 24px;overflow:auto;display:flex;flex-direction:column;gap:16px}.aito-compose-body>label{display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:500}
+.aito-compose input:not([type=checkbox]),.aito-compose select,.aito-compose textarea{width:100%;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text-primary);padding:10px 12px;font:inherit;box-sizing:border-box}.aito-compose textarea{resize:vertical;line-height:1.6}.aito-compose input:focus,.aito-compose textarea:focus,.aito-compose select:focus{outline:2px solid var(--accent-start);outline-offset:1px}.aito-inline{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.aito-inline label{display:flex;gap:8px;align-items:center;flex:1;min-width:220px}.aito-inline select{flex:1}
+.aito-compose-account{padding:14px;border:1px solid var(--border);border-radius:10px;display:flex;flex-direction:column;gap:12px}.aito-compose-account p{margin:0;font-size:13px;color:var(--text-secondary)}.aito-image-picker{display:grid;grid-template-columns:repeat(auto-fill,minmax(125px,1fr));gap:10px;max-height:280px;overflow:auto}.aito-image-option{display:flex;position:relative;flex-direction:column;gap:5px;border:1px solid var(--border);padding:8px;border-radius:8px;cursor:pointer;font-size:12px;overflow:hidden}.aito-image-option>input{position:absolute;top:12px;left:12px;width:17px;height:17px}.aito-image-option img{width:100%;height:90px;object-fit:contain;background:var(--bg)}.aito-image-option span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.aito-order{display:flex;gap:6px;align-items:center}.aito-order span{flex:1;font-size:13px;overflow-wrap:anywhere}.aito-cover-preview{max-width:230px;max-height:140px;object-fit:contain;align-self:flex-start;border-radius:8px}.aito-video-preview{max-height:210px;width:100%;background:#111;border-radius:8px}
