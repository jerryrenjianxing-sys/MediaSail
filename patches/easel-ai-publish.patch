+import { useState } from 'react';
+import { useDesktopUpdateState } from './DesktopUpdates';
+
+export default function SoftwareUpdates() {
+  const state = useDesktopUpdateState();
+  const [error, setError] = useState('');
+  const busy = state?.phase === 'checking';
+  const prepared = state?.phase === 'downloaded' || state?.phase === 'installing';
+  const downloading = state?.phase === 'downloading';
+  const open = async () => {
+    setError('');
+    try {
+      if (!await window.desktopUpdates?.openAndCheck()) setError('暂时无法打开更新窗口，请重试。');
+    } catch { setError('暂时无法打开更新窗口，请重试。'); }
+  };
+  return <section className="st-sec active" aria-label="软件更新">
+    <div className="panel-top"><strong>MediaSail</strong><span className="desc">软件更新</span></div>
+    <div className="board" style={{ padding: 24 }}>
+      <p style={{ marginTop: 0 }}>当前版本 <strong data-testid="update-current-version">{state?.current || '读取中…'}</strong></p>
+      <p style={{ opacity: .65, fontSize: 13 }}>最近检查：{state?.checkedAt ? new Date(state.checkedAt).toLocaleString('zh-CN', { hour12: false }) : '尚未检查'}</p>
+      <p role="status" aria-live="polite">{error || state?.message || '正在读取更新状态…'}</p>
+      {downloading && <div style={{ marginBottom: 16 }}>
+        <progress aria-label="更新下载进度" value={state.percent} max={100} style={{ width: '100%', accentColor: '#6d4aff' }} />
+        <span style={{ fontSize: 13 }}>已下载 {Math.round(state.percent)}%</span>
+      </div>}
+      <button className="btn btn-primary" onClick={() => void open()} disabled={!state || busy || state.phase === 'disabled'}>
+        {busy ? '检查中…' : downloading ? '查看下载进度' : prepared ? '查看更新' : '检查更新'}
+      </button>
+    </div>
+    <div className="foot-note">从 GitHub 获取新版。下载完成后，由你选择重启安装；配置、素材和登录状态会保留。</div>
+  </section>;
+}
