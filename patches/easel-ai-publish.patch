diff --git a/web/frontend/src/lib/aitoearn.ts b/web/frontend/src/lib/aitoearn.ts
new file mode 100644
index 0000000..219c2e8
--- /dev/null
+++ b/web/frontend/src/lib/aitoearn.ts
@@ -0,0 +1,46 @@
+import { useEffect, useState } from 'react';
+import type { OutputNode } from './api';
+
+export interface Compose {
+  projectPath: string; title: string; body: string; textPath: string;
+  images: string[]; video: string; cover: string; mode: 'images' | 'video';
+  files: Pick<OutputNode, 'path' | 'name' | 'kind'>[];
+}
+export interface AitoJob {
+  id: string; accountId: string; accountName: string; content: { title: string; groupId: string };
+  status: string; message: string; progress: number; createdAt: number; checkedAbsentAt?: number;
+}
+export interface AitoState {
+  compose: Compose | null; jobs: AitoJob[]; busy: boolean;
+  web: { loading: boolean; error: string; url: string }; canGoBack: boolean;
+}
+export interface Connection { user: { id: string; name: string }; groups: { id: string; name: string }[]; selectedGroup: string }
+declare global {
+  interface Window { desktopAito?: { call: (action: string, input?: unknown) => Promise<unknown>; subscribe: (callback: (state: AitoState) => void) => () => void } }
+}
+export function aitoCall<T = unknown>(action: string, input?: unknown): Promise<T> {
+  if (!window.desktopAito) return Promise.reject(new Error('此功能需要在 MediaSail 桌面软件中打开。'));
+  return window.desktopAito.call(action, input) as Promise<T>;
+}
+export function useAitoState() {
+  const [state, setState] = useState<AitoState | null>(null);
+  useEffect(() => {
+    let live = true;
+    aitoCall<AitoState>('status').then(s => { if (live) setState(s); }).catch(() => {});
+    const off = window.desktopAito?.subscribe(setState);
+    return () => { live = false; off?.(); };
+  }, []);
+  return state;
+}
+export function projectCompose(project: OutputNode): Compose {
+  const files: Compose['files'] = [];
+  const walk = (node: OutputNode) => { if (node.type === 'file') files.push({ path: node.path, name: node.name, kind: node.kind }); else node.children?.forEach(walk); };
+  walk(project);
+  const preferred = project.meta?.deliverablePaths || [];
+  const images = preferred.filter(p => /\.(png|jpe?g|webp)$/i.test(p));
+  const videos = preferred.filter(p => /\.(mp4|mov)$/i.test(p));
+  const texts = files.filter(f => /\.(md|txt|markdown)$/i.test(f.name));
+  const mode = videos.length || project.meta?.kind === 'video' ? 'video' : 'images';
+  return { projectPath: project.path, title: project.meta?.title || project.name, body: project.meta?.summary || '', textPath: texts.length === 1 ? texts[0].path : '',
+    images, video: videos.length === 1 ? videos[0] : '', cover: /\.(png|jpe?g|webp)$/i.test(project.meta?.cover || '') ? project.meta!.cover! : '', mode, files };
+}
diff --git a/web/frontend/src/lib/appStorage.ts b/web/frontend/src/lib/appStorage.ts
new file mode 100644
index 0000000..bd91a4f
--- /dev/null
+++ b/web/frontend/src/lib/appStorage.ts
@@ -0,0 +1,47 @@
+type Snapshot = {values: Record<string, string>; migration: {sessions: number; copies: number}};
+declare global { interface Window { desktopUiState?: {call(action: string, input?: unknown): Promise<Snapshot | boolean>}; mediaSailPrepareClose?: () => Promise<void>; } }
+export const isDesktopStorage = Boolean(window.desktopUiState);
+let values: Record<string, string> = {}, initialized = false;
+const pending = new Set<Promise<unknown>>();
+const dirty = new Map<string, {value: string | null}>();
+function notice(message: string) {
+  let element = document.getElementById('mediasail-storage-notice');
+  if (!element) {
+    element = document.createElement('div'); element.id = 'mediasail-storage-notice'; element.setAttribute('role', 'alert');
+    Object.assign(element.style, {position:'fixed',bottom:'18px',left:'24px',right:'24px',zIndex:'99999',padding:'14px',background:'#fff1ce',color:'#432d00',borderRadius:'12px',boxShadow:'0 4px 24px #0003'});
+    document.body.appendChild(element);
+  }
+  element.replaceChildren(document.createTextNode(message+' '));
+  const button = document.createElement('button'); button.textContent = '重新保存';
+  button.onclick = () => void flushStorage().then(() => element?.remove()).catch(() => notice('保存仍未完成，请检查磁盘空间后重试。'));
+  element.appendChild(button);
+}
+function write(action: string, input: {key: string; value?: string}) {
+  const change = {value:input.value ?? null}; dirty.set(input.key,change);
+  const task = window.desktopUiState!.call(action, input);
+  pending.add(task);
+  void task.then(() => {if (dirty.get(input.key)===change) dirty.delete(input.key);}).catch(() => {notice('界面数据尚未保存到磁盘，请不要退出软件。');}).finally(() => pending.delete(task));
+}
+export async function initializeStorage() {
+  if (!isDesktopStorage) return;
+  const result = await window.desktopUiState!.call('load') as Snapshot;
+  values = Object.assign(Object.create(null), result.values); initialized = true;
+  window.mediaSailPrepareClose = async () => {
+    document.body.inert = true;
+    try {await flushStorage();} catch (e) {document.body.inert = false; throw e;}
+  };
+  const theme = values.easel_theme;
+  if (theme === 'dark' || theme === 'light') {document.documentElement.dataset.theme = theme; document.documentElement.style.colorScheme = theme;}
+}
+export async function flushStorage() {
+  if (!isDesktopStorage) return;
+  await Promise.allSettled([...pending]);
