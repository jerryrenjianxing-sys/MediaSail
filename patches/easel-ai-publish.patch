+.skill-copy-dialog h2 {
+  font-size: 20px;
+  margin: 0 0 12px;
+}
+.skill-copy-dialog p {
+  font-size: 14px;
+  line-height: 1.8;
+  color: var(--sh-muted);
+}
+.skill-copy-dialog textarea {
+  display: block;
+  width: 100%;
+  height: 240px;
+  resize: vertical;
+  margin: 20px 0;
+  padding: 14px;
+  border: 1px solid var(--sh-line);
+  border-radius: 6px;
+  font-size: 12px;
+  background: var(--sh-bg);
+  color: var(--sh-text);
+}
+@keyframes skill-agents-scroll {
+  to {
+    transform: translateX(-50%);
+  }
+}
+@media (min-height: 900px) {
+  .skill-hero {
+    padding-top: 100px;
+    padding-bottom: 30px;
+  }
+  .skill-agents {
+    margin-bottom: 70px;
+  }
+}
+@media (min-width: 601px) and (max-height: 850px) {
+  .skill-header {
+    height: 64px;
+  }
+  .skill-hero {
+    padding: 28px 0 0;
+  }
+  .skill-eyebrow {
+    margin-bottom: 18px;
+  }
+  .skill-hero h1 {
+    font-size: clamp(44px, 7vw, 88px);
+  }
+  .skill-hero h2 {
+    font-size: 26px;
+    line-height: 1.4;
+    margin: 20px 0 12px;
+  }
+  .skill-description {
+    font-size: 15px;
+    line-height: 1.7;
+  }
+  .skill-actions {
+    margin: 25px 0 12px;
+  }
+  .skill-button {
+    min-height: 48px;
+  }
+  .skill-feedback {
+    min-height: 28px;
+    margin-top: 8px;
+  }
+  .skill-agents {
+    margin: 14px auto 22px;
+  }
+  .skill-agents-heading {
+    margin-bottom: 16px;
+  }
+  .skill-agents-note {
+    margin-top: 16px;
+  }
+  .skill-footer {
+    min-height: 54px;
+  }
+}
+@media (max-width: 600px) {
+  .skill-header {
+    height: 68px;
+    margin: 0 22px;
+    gap: 12px;
+  }
+  .skill-header-caption {
+    display: none;
+  }
+  .skill-theme {
+    margin-left: auto;
+  }
+  .skill-hero {
+    width: calc(100% - 40px);
+    padding-top: 60px;
+  }
+  .skill-eyebrow {
+    font-size: 11px;
+    letter-spacing: 1px;
+    margin-bottom: 24px;
+  }
+  .skill-hero h1 {
+    font-size: clamp(32px, 8.8vw, 52px);
+  }
+  .skill-hero h2 {
+    font-size: 23px;
+    margin-top: 24px;
+  }
+  .skill-hero h2 span {
+    display: block;
+  }
+  .skill-description {
+    font-size: 14px;
+  }
+  .skill-actions {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 10px;
+    margin-top: 27px;
+  }
+  .skill-actions .skill-button {
+    max-width: none;
+    font-size: 14px;
+    gap: 8px;
+    padding: 13px 10px;
+  }
+  .skill-button {
+    min-width: 0;
+    flex: 1;
+    max-width: 176px;
+    padding: 13px 12px;
+    font-size: 14px;
+  }
+  .skill-format {
+    font-size: 11px;
+  }
+  .skill-agents {
+    width: calc(100% - 32px);
+    margin-top: 18px;
+    margin-bottom: 30px;
+  }
+  .skill-agent-group {
+    gap: 28px;
+    padding-right: 28px;
+  }
+  .skill-agents-note {
+    font-size: 10px;
+    padding: 0 18px;
+  }
+  .skill-footer {
+    margin: 0 22px;
+    min-height: 62px;
+  }
+  .skill-copy-dialog {
+    padding: 22px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .skill-marquee-track {
+    animation: none;
+    width: auto;
+  }
+  .skill-agent-group {
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 15px 25px;
+    padding: 0;
+  }
+  .skill-agent-group[aria-hidden="true"] {
+    display: none;
+  }
+  .skill-marquee {
+    mask-image: none;
+  }
+  .skill-marquee-toggle {
+    display: none;
+  }
+  .skill-button,
+  .skill-theme {
+    transition: none;
+  }
+  .skill-button:hover:not(:disabled) {
+    transform: none;
+  }
+}
+
+/* Adapt the original standalone landing to the desktop content viewport. */
+.skill-home { overflow-y: auto; height: 100%; }
+.skill-header { min-height: 64px; height: 64px; }
+.skill-title-line { display: inline; }
+.skill-hero h1 { font-size: clamp(64px, 9vw, 116px); }
+.skill-hero { padding-top: 42px; padding-bottom: 30px; }
+.skill-copy-dialog { max-width: min(680px, calc(100vw - 48px)); }
