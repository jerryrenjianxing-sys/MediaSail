+        </>}
+      </div>
+      <footer><span>内容会上传到你的 AitoEarn 账号。此操作不会发布。</span><button className="btn" disabled={busy || coverBusy} onClick={onClose}>暂存并关闭</button><button className="btn btn-primary" disabled={!draft?.title.trim() || !draft?.body.trim() || !hasMedia || !groupId || !connection || busy || coverBusy} onClick={send}>{busy ? '正在准备…' : '保存到 AitoEarn 草稿'}</button></footer>
+    </div>
+  </div>;
+}
