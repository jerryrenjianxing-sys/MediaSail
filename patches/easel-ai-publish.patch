@@ -0,0 +1,25 @@
+import { useEffect, useState } from 'react';
+type State = { phase: string; current: string; version: string; percent: number; message: string; checkedAt: number | null; transferred: number; total: number; bytesPerSecond: number };
+declare global {
+  interface Window { desktopUpdates?: { open: () => Promise<boolean>; openAndCheck: () => Promise<boolean>; status: () => Promise<State | null>; subscribe: (callback: (state: State) => void) => () => void } }
+}
+export function useDesktopUpdateState() {
+  const [state, setState] = useState<State | null>(null);
+  useEffect(() => {
+    const bridge = window.desktopUpdates;
+    if (!bridge) return;
+    let live = true;
+    bridge.status().then(s => { if (live) setState(s); }).catch(() => {});
+    const off = bridge.subscribe(setState);
+    return () => { live = false; off(); };
+  }, []);
+  return state;
+}
+export default function DesktopUpdates() {
+  const state = useDesktopUpdateState();
+  if (!window.desktopUpdates) return null;
+  const label = state?.phase === 'available' ? '发现新版' : state?.phase === 'downloaded' ? '重启更新' : state?.phase === 'downloading' ? `下载中 ${Math.round(state.percent)}%` : '软件更新';
+  return <button className="nav-item" style={{ margin: '4px 12px', width: 'calc(100% - 24px)', fontSize: 12 }} onClick={() => { void window.desktopUpdates?.open(); }} title="从 GitHub 检查和下载 MediaSail 新版">
+    <span aria-hidden="true" className="nav-icon">↑</span>{label}<span style={{ marginLeft: 'auto', opacity: .5 }}>{state?.current}</span>
+  </button>;
+}
