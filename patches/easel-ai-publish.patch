+import { useCallback, useEffect, useRef, useState } from 'react';
+import { aitoCall, useAitoState } from '../lib/aitoearn';
+import '../styles/aitoearn.css';
+
+export default function AitoPage({ suspended, onCompose }: { suspended: boolean; onCompose: () => void }) {
+  const state = useAitoState(), viewport = useRef<HTMLDivElement>(null);
+  const [error, setError] = useState(''), [history, setHistory] = useState(false), [acting, setActing] = useState(false);
+  const newestJob = useRef('');
+  useEffect(() => { const id = state?.jobs[0]?.id; if (id && id !== newestJob.current) { newestJob.current = id; setHistory(true); } }, [state]);
+  const command = useCallback(async (action: string, input?: unknown) => {
+    setError(''); setActing(true);
+    try { await aitoCall(action, input); } catch (e) { setError((e as Error).message); } finally { setActing(false); }
+  }, []);
+  useEffect(() => {
+    const element = viewport.current; if (!element) return;
+    const sync = () => { const b = element.getBoundingClientRect(); void aitoCall('view', { visible: !suspended, bounds: { x: b.x, y: b.y, width: b.width, height: b.height } }).catch(e => setError(e.message)); };
+    const observer = new ResizeObserver(sync); observer.observe(element); window.addEventListener('resize', sync); sync();
+    return () => { observer.disconnect(); window.removeEventListener('resize', sync); void aitoCall('view', { visible: false }).catch(() => {}); };
+  }, [suspended]);
+  return <section className="aito-page" data-testid="aito-page">
+    <header className="aito-toolbar">
+      <div className="aito-heading"><strong>AI 发布</strong><span>AitoEarn 中国站</span></div>
+      <button className="btn btn-sm" disabled={!state?.canGoBack || acting} onClick={() => command('back')}>返回</button>
+      <button className="btn btn-sm" disabled={acting} onClick={() => command('home')}>首页 / 登录</button>
+      <button className="btn btn-sm" disabled={acting} onClick={() => command('refresh')}>刷新</button>
+      <button className="btn btn-sm" onClick={() => command('external')}>浏览器打开 ↗</button>
+      {state?.compose && <button className="btn btn-sm btn-primary" onClick={onCompose}>待发送内容</button>}
+      <button className="btn btn-sm" onClick={() => setHistory(v => !v)}>发送记录 {state?.jobs.length || ''}</button>
+    </header>
+    {error && <div className="aito-notice" role="alert">{error}</div>}
+    {state?.busy && !history && <button className="aito-progress" onClick={() => setHistory(true)}>{state.jobs.find(j => ['checking', 'uploading', 'creating'].includes(j.status))?.message || '正在准备素材…'}</button>}
+    {history && <div className="aito-history">
+      {!state?.jobs.length && <p>还没有发送记录。从 Easel 内容库选择成品，即可带入 AitoEarn 草稿箱。</p>}
+      {state?.jobs.map(job => <article key={job.id} className="aito-job">
+        <div><strong>{job.content.title}</strong><small>{job.accountName} · {new Date(job.createdAt).toLocaleString()}</small><p>{job.message}</p>
+          {['checking', 'uploading', 'creating'].includes(job.status) && <progress max={100} value={job.progress} />}</div>
+        <div className="aito-job-actions">
+          {job.status === 'done' && <button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('openDraft', { id: job.id })}>打开草稿</button>}
+          {['failed', 'paused', 'login'].includes(job.status) && <button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('retry', { id: job.id })}>继续发送</button>}
+          {job.status === 'uncertain' && <><button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('reconcile', { id: job.id })}>核对草稿结果</button>
+            {job.checkedAbsentAt && <button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('retry', { id: job.id, confirmedAbsent: true })}>确认未创建，重新发送</button>}</>}
+        </div>
+      </article>)}
+    </div>}
+    <div ref={viewport} className="aito-viewport" data-testid="aito-viewport">
+      <div className="aito-placeholder">{state?.web.error ? <><p>{state.web.error}</p><button className="btn btn-primary" onClick={() => command('refresh')}>重试加载</button></> : <p>正在打开 AitoEarn…</p>}</div>
+    </div>
+    <footer className="aito-footer">{state?.web.loading ? '页面加载中…' : '内容仅保存为草稿，发布请在 AitoEarn 中确认。'} 需要官方浏览器插件时，可选择「浏览器打开」。</footer>
+  </section>;
+}
