@@ -0,0 +1,42 @@
+import '../styles/update-banner.css';
+import { useEffect, useState } from 'react';
+type State = { bannerDismissed: boolean; phase: string; current: string; version: string; percent: number; message: string; checkedAt: number | null; transferred: number; total: number; bytesPerSecond: number };
+declare global {
+  interface Window { desktopUpdates?: { open: () => Promise<boolean>; openAndCheck: () => Promise<boolean>; dismissBanner: () => Promise<boolean>; status: () => Promise<State | null>; subscribe: (callback: (state: State) => void) => () => void } }
+}
+export function useDesktopUpdateState() {
+  const [state, setState] = useState<State | null>(null);
+  useEffect(() => {
+    const bridge = window.desktopUpdates;
+    if (!bridge) return;
+    let live = true, received = false;
+    bridge.status().then(s => { if (live && !received) setState(s); }).catch(() => {});
+    const off = bridge.subscribe(s => { received = true; if (live) setState(s); });
+    return () => { live = false; off(); };
+  }, []);
+  return state;
+}
+export default function DesktopUpdates() {
+  const state = useDesktopUpdateState();
+  if (!window.desktopUpdates) return null;
+  const label = state?.phase === 'available' ? '发现新版' : state?.phase === 'downloaded' ? '重启更新' : state?.phase === 'downloading' ? `下载中 ${Math.round(state.percent)}%` : '软件更新';
+  return <button className="nav-item" style={{ margin: '4px 12px', width: 'calc(100% - 24px)', fontSize: 12 }} onClick={() => { void window.desktopUpdates?.open(); }} title="从 GitHub 检查和下载 MediaSail 新版">
+    <span aria-hidden="true" className="nav-icon">↑</span>{label}<span style={{ marginLeft: 'auto', opacity: .5 }}>{state?.current}</span>
+  </button>;
+}
+
+export function UpdateBanner() {
+  const state = useDesktopUpdateState();
+  const [error, setError] = useState('');
+  if (!window.desktopUpdates || !state || state.bannerDismissed || !['available', 'downloading', 'downloaded'].includes(state.phase)) return null;
+  return <aside className="desktop-update-banner" role="status" aria-label="软件更新提示">
+    <span><strong>发现 MediaSail 新版本 {state.version}</strong>
+      {state.phase === 'downloading' && <small> · 下载中 {Math.round(state.percent)}%</small>}
+      {state.phase === 'downloaded' && <small> · 已下载，可重启安装</small>}
+      {error && <small> · {error}</small>}
+    </span>
+    <button className="btn btn-sm" onClick={() => { void window.desktopUpdates?.open(); }}>查看更新</button>
+    <button className="update-banner-close" aria-label="关闭更新提示，本次运行不再提醒" title="下次启动再提醒"
+      onClick={() => { void window.desktopUpdates?.dismissBanner().catch(() => setError('关闭失败，请重试')); }}>×</button>
+  </aside>;
+}
