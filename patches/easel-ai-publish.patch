+  const change = (update: Partial<Compose>) => setDraft(d => d ? { ...d, ...update } : d);
+  const connect = useCallback(async () => {
+    setConnecting(true); setAccountError('');
+    try { const c = await aitoCall<Connection>('connection'); setConnection(c); setGroupId(c.groups.some(g => g.id === c.selectedGroup) ? c.selectedGroup : ''); }
+    catch (e) { setConnection(null); setAccountError((e as Error).message); } finally { setConnecting(false); }
+  }, []);
+  useEffect(() => {
+    let live = true;
+    const init = async () => {
+      try {
+        const d = project ? projectCompose(project) : (await aitoCall<AitoState>('status')).compose;
+        if (!d) { if (live) setError('没有待发送内容，请从内容库选择项目。'); return; }
+        if (project && d.textPath) d.body = (await fetchOutputContent(d.textPath)).content;
+        if (live) setDraft(d);
+      } catch (e) { if (live) setError((e as Error).message); }
+    };
+    void init(); void connect();
+    return () => { live = false; };
+  }, [project, connect]);
+  useEffect(() => {
+    if (!draft) return;
