+    {history && <div className="aito-history">
+      {!state?.jobs.length && <p>还没有发送记录。从 MediaSail 内容库选择成品，即可带入 AitoEarn 草稿箱。</p>}
+      {state?.jobs.map(job => <article key={job.id} className="aito-job">
+        <div><strong>{job.content.title}</strong><small>{job.accountName} · {new Date(job.createdAt).toLocaleString()}</small><p>{job.message}</p>
+          {['checking', 'uploading', 'creating'].includes(job.status) && <progress max={100} value={job.progress} />}</div>
+        <div className="aito-job-actions">
+          {job.status === 'done' && <button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('openDraft', { id: job.id })}>打开草稿</button>}
+          {['failed', 'paused', 'login'].includes(job.status) && <button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('retry', { id: job.id })}>继续发送</button>}
+          {job.status === 'uncertain' && <><button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('reconcile', { id: job.id })}>核对草稿结果</button>
+            {job.checkedAbsentAt && <button className="btn btn-sm" disabled={acting || state.busy} onClick={() => command('retry', { id: job.id, confirmedAbsent: true })}>确认未创建，重新发送</button>}</>}
+        </div>
+      </article>)}
+    </div>}
+    <div ref={viewport} className="aito-viewport" data-testid="aito-viewport">
+      <div className="aito-placeholder">{state?.web.error ? <><p>{state.web.error}</p><button className="btn btn-primary" onClick={() => command('refresh')}>重试加载</button></> : <p>正在打开 AitoEarn…</p>}</div>
+    </div>
+    <footer className="aito-footer">{state?.web.loading ? '页面加载中…' : '内容仅保存为草稿，发布请在 AitoEarn 中确认。'} 需要官方浏览器插件时，可选择「浏览器打开」。</footer>
+  </section>;
+}
