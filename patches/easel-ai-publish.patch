+
+export default function SendToAitoModal({ project, onClose, onOpenAito }: { project?: OutputNode; onClose: () => void; onOpenAito: () => void }) {
+  const [draft, setDraft] = useState<Compose | null>(null), [connection, setConnection] = useState<Connection | null>(null);
+  const [groupId, setGroupId] = useState(''), [error, setError] = useState(''), [accountError, setAccountError] = useState('');
+  const [busy, setBusy] = useState(false), [connecting, setConnecting] = useState(false), [coverBusy, setCoverBusy] = useState(false);
