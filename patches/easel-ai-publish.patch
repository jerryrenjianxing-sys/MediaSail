+  for (const [key,change] of dirty) {await window.desktopUiState!.call(change.value===null?'remove':'set',{key,value:change.value});if (dirty.get(key)===change)dirty.delete(key);}
+  await window.desktopUiState!.call('flush');
+}
+export const appStorage = {
+  getItem(key: string): string | null {if (!isDesktopStorage) return localStorage.getItem(key); if (!initialized) throw new Error('界面数据尚未加载。'); return values[key] ?? null;},
+  setItem(key: string, value: string) {if (!isDesktopStorage) return localStorage.setItem(key,value); if (!initialized) throw new Error('界面数据尚未加载。'); values[key]=value; write('set',{key,value});},
+  removeItem(key: string) {if (!isDesktopStorage) return localStorage.removeItem(key); if (!initialized) throw new Error('界面数据尚未加载。'); delete values[key]; write('remove',{key});},
+};
