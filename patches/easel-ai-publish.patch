+import { useCallback, useEffect, useRef, useState } from 'react';
+import { fetchOutputContent, mediaUrl } from '../lib/api';
+import type { OutputNode } from '../lib/api';
+import { aitoCall, projectCompose } from '../lib/aitoearn';
+import type { AitoState, Compose, Connection } from '../lib/aitoearn';
+import '../styles/aitoearn.css';
+
+export default function SendToAitoModal({ project, onClose, onOpenAito }: { project?: OutputNode; onClose: () => void; onOpenAito: () => void }) {
+  const [draft, setDraft] = useState<Compose | null>(null), [connection, setConnection] = useState<Connection | null>(null);
+  const [groupId, setGroupId] = useState(''), [error, setError] = useState(''), [accountError, setAccountError] = useState('');
+  const [busy, setBusy] = useState(false), [connecting, setConnecting] = useState(false), [coverBusy, setCoverBusy] = useState(false);
+  const draftRef = useRef(draft), textRequest = useRef(0); draftRef.current = draft;
+  const change = (update: Partial<Compose>) => setDraft(d => d ? { ...d, ...update } : d);
+  const connect = useCallback(async () => {
+    setConnecting(true); setAccountError('');
+    try { const c = await aitoCall<Connection>('connection'); setConnection(c); setGroupId(c.groups.some(g => g.id === c.selectedGroup) ? c.selectedGroup : ''); }
+    catch (e) { setConnection(null); setAccountError((e as Error).message); } finally { setConnecting(false); }
+  }, []);
+  useEffect(() => {
+    let live = true;
+    const init = async () => {
+      try {
+        const d = project ? projectCompose(project) : (await aitoCall<AitoState>('status')).compose;
+        if (!d) { if (live) setError('没有待发送内容，请从内容库选择项目。'); return; }
+        if (project && d.textPath) d.body = (await fetchOutputContent(d.textPath)).content;
+        if (live) setDraft(d);
+      } catch (e) { if (live) setError((e as Error).message); }
+    };
+    void init(); void connect();
+    return () => { live = false; };
+  }, [project, connect]);
+  useEffect(() => {
+    if (!draft) return;
+    const timer = setTimeout(() => { void aitoCall('compose', draft).catch(e => setError(e.message)); }, 250);
+    return () => clearTimeout(timer);
+  }, [draft]);
+  useEffect(() => () => { if (draftRef.current) void aitoCall('compose', draftRef.current).catch(() => {}); }, []);
+  const readText = async (file: string) => {
+    const seq = ++textRequest.current; change({ textPath: file }); if (!file) return;
+    try { const value = await fetchOutputContent(file); if (seq === textRequest.current) change({ body: value.content }); } catch (e) { setError((e as Error).message); }
+  };
+  const goToSite = async () => { if (draft) await aitoCall('compose', draft); onClose(); onOpenAito(); };
+  const createGroup = async () => {
+    setConnecting(true); setAccountError('');
+    try { const g = await aitoCall<{ id: string; name: string }>('group'); await connect(); setGroupId(g.id); }
+    catch (e) { setAccountError((e as Error).message); } finally { setConnecting(false); }
+  };
+  const makeCover = async () => {
+    if (!draft?.video) return; setCoverBusy(true); setError(''); const video = draft.video;
+    try { const p = await aitoCall<string>('cover', { path: video }); setDraft(d => d?.video === video ? { ...d, cover: p, files: d.files.some(f => f.path === p) ? d.files : [...d.files, {path:p,name:'视频首帧封面',kind:'image'}] } : d); }
+    catch (e) { setError((e as Error).message); } finally { setCoverBusy(false); }
+  };
+  const send = async () => {
+    if (!draft || !connection) return; setBusy(true); setError('');
+    try {
+      await aitoCall('compose', draft);
+      await aitoCall<string>('send', { title:draft.title, body:draft.body, groupId, accountId:connection.user.id,
+        images:draft.mode === 'images' ? draft.images : [], video:draft.mode === 'video' ? draft.video : '', cover:draft.cover });
+      onClose(); onOpenAito();
+    } catch (e) { setError((e as Error).message); } finally { setBusy(false); }
+  };
+  const images = draft?.files.filter(f => /\.(png|jpe?g|webp)$/i.test(f.path)) || [];
+  const videos = draft?.files.filter(f => /\.(mp4|mov)$/i.test(f.path)) || [];
