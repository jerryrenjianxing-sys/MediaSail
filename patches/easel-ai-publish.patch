@@ -0,0 +1,19 @@
+// Shared by all application brand marks; keep user content and storage keys intact.
+export const PRODUCT_NAME = 'MediaSail';
+export const PRODUCT_ICON = './assets/mediasail-icon.png';
+
+// Descriptions are presentation copy; skill IDs, commands and source files stay intact.
+export const brandSkillDescription = (text: string) => text.replace(/\bEasel\b/g, PRODUCT_NAME);
+
+export function brandSkillHtml(html: string): string {
+  const doc = new DOMParser().parseFromString(html, 'text/html');
+  const walker = doc.createTreeWalker(doc.body, NodeFilter.SHOW_TEXT);
+  let node: Node | null;
+  while ((node = walker.nextNode())) {
+    const parent = node.parentElement;
+    // Keep source links, executable examples, and copyright/origin statements literal.
+    if (!parent || parent.closest('a, code, pre') || /自研|版权|copyright|licen[sc]e|许可证|©/i.test(parent.textContent || '')) continue;
+    node.textContent = brandSkillDescription(node.textContent || '');
+  }
+  return doc.body.innerHTML;
+}
