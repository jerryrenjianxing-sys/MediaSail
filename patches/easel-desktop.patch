+import { useEffect, useRef } from 'react';
+/** Re-read business data after another app/Agent has edited it; never owns drafts. */
+export function useRefreshOnFocus(refresh: () => void) {
+  const latest = useRef(refresh);
+  latest.current = refresh;
+  useEffect(() => {
+    let last = 0;
+    const reload = () => {
+      if (document.hidden || Date.now() - last < 500) return;
+      last = Date.now(); latest.current();
+    };
+    window.addEventListener('focus', reload);
+    document.addEventListener('visibilitychange', reload);
+    return () => { window.removeEventListener('focus', reload); document.removeEventListener('visibilitychange', reload); };
+  }, []);
+}
