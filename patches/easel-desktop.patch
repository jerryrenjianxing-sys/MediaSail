@@ -0,0 +1,30 @@
+import { useState } from 'react';
+import { fetchLocalApi, loadSkillMarkdown } from '../lib/agent-home-loader';
+/** Optional context for one business task; no queue or Agent execution. */
+export default function AgentTaskContext({ title, task, persona, onConnectAgent }: {
+  title: string; task: string; persona?: string; onConnectAgent: () => void;
+}) {
+  const [busy, setBusy] = useState(false), [message, setMessage] = useState(''), [manual, setManual] = useState('');
+  const copy = async () => {
+    if (busy) return;
+    setBusy(true); setMessage('');
+    try {
+      const connect = await loadSkillMarkdown(() => fetchLocalApi('/api/platform-skill?format=connect', { cache: 'no-store' }, 15000));
+      const text = connect + '\n\n## 本次任务：' + title + '\n' +
+        (persona ? '目标画像：' + JSON.stringify(persona) + '\n' : '未指定画像；按本次任务选择所需业务资料。\n') +
+        task + '\n\n请读取最新业务资料，保持采用的数据口径可追溯；创作工具由你选择。';
+      try { await navigator.clipboard.writeText(text); setMessage('已复制，粘贴给你熟悉的 Agent 即可。'); }
+      catch { setManual(text); setMessage('剪贴板不可用，请手动复制下面的任务资料。'); }
+    } catch (e) { setMessage(e instanceof Error ? e.message : '无法读取连接资料，请重试。'); }
+    finally { setBusy(false); }
+  };
+  return <div className="panel" style={{ marginTop: 12 }}>
+    <p style={{ color: 'var(--text-secondary)', lineHeight: 1.6 }}>研究、解释和创作由你的外部 Agent 完成。通过「连接 Agent」获取 Skill；需要时可一并带上本次业务背景。</p>
+    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
+      <button className="btn" onClick={onConnectAgent}>连接 Agent</button>
+      <button className="btn btn-sm" disabled={busy} onClick={copy}>{busy ? '正在准备…' : '复制本次任务资料'}</button>
+    </div>
+    {message && <p role="status">{message}</p>}
+    {manual && <><textarea aria-label="手动复制任务资料" className="field" rows={9} readOnly value={manual} onFocus={e => e.currentTarget.select()} /><button className="btn btn-sm" onClick={() => setManual('')}>收起</button></>}
+  </div>;
+}
diff --git a/web/frontend/src/components/AgentThemeToggle.tsx b/web/frontend/src/components/AgentThemeToggle.tsx
new file mode 100644
index 0000000..95afe4d
--- /dev/null
+++ b/web/frontend/src/components/AgentThemeToggle.tsx
@@ -0,0 +1,89 @@
+import { useEffect, useRef } from 'react';
+import { gsap } from 'gsap';
+import { getTheme, setThemePreference, useTheme } from '../lib/theme';
+import type { Theme } from '../lib/theme';
+
+export default function AgentThemeToggle() {
+  const theme = useTheme();
+  const button = useRef<HTMLButtonElement>(null);
+  const layer = useRef<HTMLDivElement>(null);
+  const icon = useRef<HTMLSpanElement>(null);
+  const pending = useRef<Theme | null>(null);
+
+  useEffect(() => {
+    const overlay = layer.current;
+    const symbol = icon.current;
+    return () => {
+      gsap.killTweensOf([overlay, symbol]);
+      // Entering the console during the wipe keeps the user's last selection.
+      if (pending.current) setThemePreference(pending.current);
+      pending.current = null;
+    };
+  }, []);
+
+  function toggleTheme() {
+    const next: Theme = (pending.current ?? getTheme()) === 'dark' ? 'light' : 'dark';
+    const overlay = layer.current;
+    const symbol = icon.current;
+    gsap.killTweensOf([overlay, symbol]);
+    pending.current = next;
+    const finish = () => {
+      setThemePreference(next);
+      pending.current = null;
+    };
+    if (!overlay || !button.current || window.matchMedia('(prefers-reduced-motion: reduce)').matches || next === getTheme()) {
+      if (overlay) gsap.set(overlay, { display: 'none', clearProps: 'clipPath,opacity' });
+      if (symbol) gsap.set(symbol, { clearProps: 'transform' });
+      finish();
+      return;
+    }
+
+    // Match the MediaFlow / Media Deep Researcher circular theme wipe.
+    const bounds = button.current.getBoundingClientRect();
+    const x = bounds.left + bounds.width / 2;
+    const y = bounds.top + bounds.height / 2;
+    const radius = Math.ceil(Math.hypot(
+      Math.max(x, window.innerWidth - x),
+      Math.max(y, window.innerHeight - y),
+    ));
+    overlay.dataset.nextTheme = next;
+    gsap.set(overlay, { display: 'block', opacity: 1, clipPath: `circle(0px at ${x}px ${y}px)` });
+    gsap.to(overlay, {
+      clipPath: `circle(${radius}px at ${x}px ${y}px)`,
+      duration: 0.48,
+      ease: 'power3.inOut',
+      onComplete: () => {
+        finish();
+        gsap.to(overlay, {
+          opacity: 0,
+          duration: 0.16,
+          ease: 'power1.out',
+          onComplete: () => { gsap.set(overlay, { display: 'none' }); },
+        });
+      },
+    });
+    if (symbol) gsap.fromTo(symbol,
+      { rotation: next === 'dark' ? -90 : 90, scale: 0.8 },
+      { rotation: 0, scale: 1, duration: 0.55, ease: 'power2.out', clearProps: 'transform' },
+    );
+  }
+
+  const label = theme === 'dark' ? '切换到浅色主题' : '切换到深色主题';
+  return (
+    <>
+      <button ref={button} type="button" className="skill-theme" aria-label={label} title={label} onClick={toggleTheme}>
+        <span ref={icon} className="skill-theme-icon" aria-hidden="true">
+          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.75" strokeLinecap="round" strokeLinejoin="round">
+            {theme === 'dark' ? (
+              <>
+                <circle cx="12" cy="12" r="4" />
+                <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
+              </>
+            ) : <path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" />}
+          </svg>
+        </span>
+      </button>
+      <div ref={layer} className="skill-theme-transition" aria-hidden="true" />
+    </>
+  );
+}
