+    """Only a top-level ordinary project; never create/rename a folder here."""
+    if (not project or project.endswith((" ", ".")) or
+            re.search(r'[<>:"/\\|?*\x00-\x1f]', project) or project in {".", ".."}):
+        raise HTTPException(400, {"code": "invalid_project", "message": "请选择内容库中的单个项目。"})
+    candidate = OUTPUTS_DIR / project
+    try:
+        full = _safe_output_target(project, must_exist=False)
+    except HTTPException as error:
+        raise HTTPException(403, {"code": "invalid_project", "message": "项目必须位于内容库内。"}) from error
+    if _is_protected(full) or project.startswith((".", "_")):
+        raise HTTPException(403, {"code": "protected_project", "message": "系统目录不能作为内容库项目编辑。"})
+    try:
+        info = candidate.lstat()
+        linked = candidate.is_symlink() or getattr(info, "st_reparse_tag", 0) in {0xA0000003, 0xA000000C}
+        if not stat.S_ISDIR(info.st_mode) or linked or full.parent != OUTPUTS_DIR.resolve():
+            raise HTTPException(403, {"code": "invalid_project", "message": "项目必须是内容库中的普通一级文件夹。"})
+    except FileNotFoundError:
+        raise HTTPException(404, {"code": "project_not_found", "message": "项目已不存在，请刷新内容库。"})
+    return full / project_manifest.MANIFEST_NAME
+
+
+def _metadata_error(error: Exception):
+    if isinstance(error, project_manifest.ManifestError):
+        detail = {"code": error.code, "message": str(error)}
+        if error.current is not None:
+            detail["current"] = error.current
+        raise HTTPException(error.status, detail) from error
+    raise HTTPException(500, {"code": "metadata_io_error", "message": "项目登记无法读写，原文件未被替换；请检查权限或稍后重试。"}) from error
+
