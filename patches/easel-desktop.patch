+/// <reference types="node" />
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolveSelectedProfile } from './profileSelection.ts';
+
+const names = ['历史 画像', '新画像'];
+const sessions = JSON.stringify([{ id: 'older', persona: '新画像' }, { id: 'active', persona: '历史 画像' }]);
+test('migrates only the active legacy session to an existing independent profile', () => {
+  assert.equal(resolveSelectedProfile(names, null, sessions, 'active'), '历史 画像');
+});
+test('an explicit empty choice never revives the old chat profile', () => {
+  assert.equal(resolveSelectedProfile(names, '', sessions, 'active'), '');
+});
+test('a saved independent profile wins over the old active session', () => {
+  assert.equal(resolveSelectedProfile(names, '新画像', sessions, 'active'), '新画像');
+});
+test('a deleted saved profile clears instead of falling back to an unrelated old session', () => {
+  assert.equal(resolveSelectedProfile(names, '已删除', sessions, 'active'), '');
+});
+test('deleted or missing legacy targets do not select another profile by guess', () => {
+  assert.equal(resolveSelectedProfile(['新画像'], null, sessions, 'active'), '');
+  assert.equal(resolveSelectedProfile(names, null, sessions, 'missing'), '');
+  assert.equal(resolveSelectedProfile(names, null, sessions, null), '');
+});
+test('malformed old history is nonfatal and never needs a destructive reset', () => {
+  for (const raw of ['{', '{}', 'null', '[null,1,"text"]']) assert.equal(resolveSelectedProfile(names, null, raw, 'active'), '');
+});
