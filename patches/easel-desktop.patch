+  border-bottom: 1px solid var(--sh-line);
+}
+.skill-brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 16px;
+  font-weight: 650;
+  letter-spacing: -0.5px;
+}
+.skill-brand img {
+  display: block;
+}
+.skill-header-caption {
