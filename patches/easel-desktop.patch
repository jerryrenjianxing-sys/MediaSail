+export const SELECTED_PROFILE_KEY = 'mediasail_selected_profile';
+/** Only a missing preference migrates; an explicit empty choice is intentional. */
+export function resolveSelectedProfile(names: string[], saved: string | null, sessions: string | null, active: string | null): string {
+  if (saved !== null) return names.includes(saved) ? saved : '';
+  try {
+    const rows: unknown = JSON.parse(sessions || '[]');
+    if (!Array.isArray(rows)) return '';
+    const legacy = rows.find(row => row && typeof row === 'object' && row.id === active);
+    return typeof legacy?.persona === 'string' && names.includes(legacy.persona) ? legacy.persona : '';
+  } catch { return ''; }
+}
