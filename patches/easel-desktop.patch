new file mode 100644
index 0000000..ae08227
--- /dev/null
+++ b/skills/shared/scripts/business_browser.py
@@ -0,0 +1,70 @@
+"""Resolve an installed browser for MediaSail business operations.
+
+Only the executable is shared with Chrome/Edge. Callers keep their existing
+MediaSail platform profiles, never the user's normal browser profile. No browser
+is downloaded and Playwright's private driver is still required.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+from pathlib import Path
+
+
+class BrowserUnavailable(RuntimeError):
+    pass
+
+
+def _registry_paths(executable: str):
+    if os.name != "nt":
+        return []
+    import winreg
+    results = []
+    subkey = rf"Software\Microsoft\Windows\CurrentVersion\App Paths\{executable}"
+    for hive in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
+        for view in (0, winreg.KEY_WOW64_64KEY, winreg.KEY_WOW64_32KEY):
+            try:
+                with winreg.OpenKey(hive, subkey, 0, winreg.KEY_READ | view) as key:
+                    value, _ = winreg.QueryValueEx(key, "")
+                    if isinstance(value, str):
+                        results.append(Path(os.path.expandvars(value.strip().strip('"'))))
+            except OSError:
+                pass
+    return results
+
+
+def _candidates(product: str):
+    executable = "chrome.exe" if product == "chrome" else "msedge.exe"
+    vendor = ("Google", "Chrome") if product == "chrome" else ("Microsoft", "Edge")
+    roots = [os.environ.get("PROGRAMFILES", r"C:\Program Files"),
+             os.environ.get("PROGRAMFILES(X86)", r"C:\Program Files (x86)"),
+             os.environ.get("EASEL_HOST_LOCALAPPDATA"), os.environ.get("LOCALAPPDATA")]
+    result = [Path(root).joinpath(*vendor, "Application", executable) for root in roots if root]
+    result.extend(_registry_paths(executable))
+    for name in (("google-chrome", "google-chrome-stable", "chrome") if product == "chrome"
+                 else ("microsoft-edge", "msedge")):
+        found = shutil.which(name)
+        if found:
+            result.append(Path(found))
+    return result
+
+
+def resolve_browser() -> Path:
+    for key in ("EASEL_BROWSER_EXECUTABLE", "EASEL_BROWSER_PATH", "EASEL_CLOAK_BROWSER"):
+        configured = (os.environ.get(key) or "").strip().strip('"')
+        if configured:
+            browser = Path(os.path.expandvars(configured)).expanduser()
+            if browser.is_file():
+                return browser.resolve()
+            raise BrowserUnavailable(f"已配置的浏览器不存在：{browser}。请修正 {key} 后重试。")
+    for product in ("chrome", "edge"):
+        for browser in _candidates(product):
+            if browser.is_file():
+                return browser.resolve()
+    raise BrowserUnavailable("未找到 Chrome 或 Edge。请安装其中一个，或通过 EASEL_BROWSER_EXECUTABLE 指定浏览器路径；MediaSail 本地资料仍可使用。")
+
+
+def launch_persistent_context(chromium, profile, **kwargs):
+    kwargs.pop("channel", None)
+    kwargs["executable_path"] = str(resolve_browser())
+    return chromium.launch_persistent_context(str(profile), **kwargs)
