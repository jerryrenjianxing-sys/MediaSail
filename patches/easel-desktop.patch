+.library-controls,.library-detail { max-width:1160px; margin:16px auto; }
+.library-categories { display:flex; flex-wrap:wrap; gap:8px; }
+.library-search { width:100%; margin:14px 0 12px; }
+.library-facets { display:flex; flex-wrap:wrap; align-items:flex-end; gap:12px; }
+.library-facets label { display:flex; flex:1 1 130px; min-width:120px; flex-direction:column; gap:6px; font-size:12px; color:var(--text-secondary); }
+.library-facets select { width:100%; }
+.library-results { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin:12px 0; color:var(--text-secondary); font-size:13px; }
+.library-detail { padding:16px 18px; background:var(--surface-2); border:1px solid var(--border); border-radius:var(--radius); overflow-wrap:anywhere; }
+.library-detail p { white-space:pre-wrap; margin:8px 0; }
+.library-project-summary { margin:7px 0; font-size:12px; color:var(--text-secondary); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
+.library-project-path { color:var(--text-tertiary); font-size:11px; overflow-wrap:anywhere; margin-top:6px; }
+.library-project-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
+.metadata-editor { width:760px; max-width:calc(100vw - 36px); max-height:calc(100vh - 40px); overflow-y:auto; }
+.metadata-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; }
+.metadata-heading h2 { margin:0; }
+.metadata-path { font-size:12px; color:var(--text-secondary); overflow-wrap:anywhere; }
+.metadata-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin:18px 0; }
+.metadata-field { display:flex; flex-direction:column; gap:6px; font-size:13px; color:var(--text-secondary); }
+.metadata-field .field { width:100%; }
+.metadata-wide { grid-column:1/-1; }
+.metadata-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:10px; position:sticky; bottom:-28px; padding:14px 0; background:var(--surface); border-top:1px solid var(--border); }
+.metadata-actions > :first-child { margin-right:auto; }
+.metadata-notice { padding:10px 12px; background:var(--accent-soft); border-radius:var(--radius); }
