+import { useCallback, useEffect, useRef, useState } from 'react';
+import { ApiRequestError, fetchPersonas, fetchProjectMetadata, saveProjectMetadata } from '../lib/api';
+import type { ProjectMetadataSnapshot } from '../lib/api';
+import { CATEGORIES, KINDS, STAGES, draftFrom, metadataDelta, registerProjectEdits, projectCloseApproved, resetProjectCloseApproval } from '../lib/outputMetadata';
+import type { MetadataDraft } from '../lib/outputMetadata';
+import { registerUnsavedEdits } from '../lib/unsaved';
+import { useRefreshOnFocus } from '../lib/useRefreshOnFocus';
+
+interface Props { project: string; profiles: string[]; platforms: string[]; onClose: () => void; onSaved: () => void; }
+export default function ProjectMetadataEditor({ project, profiles, platforms, onClose, onSaved }: Props) {
+  const [base, setBase] = useState<ProjectMetadataSnapshot | null>(null);
+  const [draft, setDraft] = useState<MetadataDraft | null>(null);
+  const [external, setExternal] = useState<ProjectMetadataSnapshot | null>(null);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [reading, setReading] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [knownProfiles, setKnownProfiles] = useState<string[]>([]);
+  const operation = useRef(false), sequence = useRef(0);
+  const current = useRef({ base, draft }); current.current = { base, draft };
+  const dirty = Boolean(base && draft && Object.keys(metadataDelta(draftFrom(base.metadata), draft)).length);
+  const isDirty = () => {
+    const value = current.current;
+    return operation.current || Boolean(value.base && value.draft && Object.keys(metadataDelta(draftFrom(value.base.metadata), value.draft)).length);
+  };
+  useEffect(() => {
+    const reader = () => isDirty();
+    const remove = registerUnsavedEdits('project-metadata', reader), removeProject = registerProjectEdits(reader, () => operation.current);
+    const beforeUnload = (event: BeforeUnloadEvent) => { if (reader() && !projectCloseApproved()) { event.preventDefault(); event.returnValue = ''; } };
+    window.addEventListener('beforeunload', beforeUnload);
+    return () => { sequence.current++; remove(); removeProject(); window.removeEventListener('beforeunload', beforeUnload); };
+  }, []);
+
+  const apply = useCallback((value: ProjectMetadataSnapshot) => {
+    setBase(value); setDraft(draftFrom(value.metadata)); setExternal(null); setError(''); setNotice('');
+  }, []);
+  const read = useCallback(async () => {
+    if (operation.current) return;
+    const seq = ++sequence.current; setReading(true); setError('');
+    try {
+      const value = await fetchProjectMetadata(project);
+      if (seq !== sequence.current) return;
+      const old = current.current;
+      const changed = Boolean(old.base && old.draft && Object.keys(metadataDelta(draftFrom(old.base.metadata), old.draft)).length);
+      if (changed && old.base?.revision !== value.revision) { setExternal(value); setNotice('归档信息已有外部更新，你的未保存编辑仍然保留。'); }
+      else if (!changed) apply(value);
+      else { setExternal(null); setNotice('已核对最新版本，你的未保存编辑仍然保留。'); }
+    } catch (e) {
+      if (seq === sequence.current) setError(e instanceof Error ? e.message : '无法读取归档信息，现有内容未改动。');
+    } finally { if (seq === sequence.current) setReading(false); }
+  }, [project, apply]);
+  useEffect(() => { void read(); }, [read]);
+  useRefreshOnFocus(() => { void read(); });
+  useEffect(() => {
+    let alive = true;
+    void fetchPersonas().then(value => { if (alive) setKnownProfiles(value.map(p => p.name)); }).catch(() => { /* Suggestions are optional; the field stays editable. */ });
+    return () => { alive = false; };
+  }, []);
+
+  const close = () => {
+    if (operation.current) return;
+    if (dirty && !window.confirm('归档信息还有未保存的修改。放弃这些修改并关闭吗？')) return;
+    onClose();
+  };
+  const change = (key: keyof MetadataDraft, value: string) => { resetProjectCloseApproval(); setDraft(old => old ? { ...old, [key]: value } : old); setNotice(''); };
+  const save = async () => {
+    if (!base || !draft || operation.current || !dirty) return;
