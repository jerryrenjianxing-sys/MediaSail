+  height: 42px;
+  object-fit: contain;
+  filter: grayscale(1) invert(1);
+  mix-blend-mode: multiply;
+}
+[data-theme="dark"] .skill-agent-group img {
+  filter: grayscale(1);
+  mix-blend-mode: screen;
+}
+.skill-agents:hover .skill-marquee-track,
+.skill-agents:focus-within .skill-marquee-track,
+.skill-agents.is-paused .skill-marquee-track {
