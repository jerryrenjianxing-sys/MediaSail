@@ -0,0 +1,66 @@
+import { useLayoutEffect, useSyncExternalStore } from 'react';
+import { appStorage } from './appStorage';
+
+export type Theme = 'light' | 'dark';
+// Keep this key in sync with the pre-paint script in index.html.
+const THEME_KEY = 'easel_theme';
+const DARK_QUERY = '(prefers-color-scheme: dark)';
+
+function readPreference(): Theme | null {
+  try {
+    const value = appStorage.getItem(THEME_KEY);
+    return value === 'light' || value === 'dark' ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+let preference = readPreference();
+const resolveTheme = (): Theme => preference ?? (window.matchMedia(DARK_QUERY).matches ? 'dark' : 'light');
+let currentTheme = resolveTheme();
+const listeners = new Set<() => void>();
+
+function applyTheme(theme: Theme) {
+  document.documentElement.dataset.theme = theme;
+  document.documentElement.style.colorScheme = theme;
+  if (currentTheme === theme) return;
+  currentTheme = theme;
+  for (const notify of listeners) notify();
+}
+
+export const getTheme = (): Theme => currentTheme;
+
+export function setThemePreference(theme: Theme) {
+  preference = theme;
+  applyTheme(theme);
+  try { appStorage.setItem(THEME_KEY, theme); } catch { /* Still switch for this visit. */ }
+}
+
+function subscribe(notify: () => void) {
+  listeners.add(notify);
+  return () => { listeners.delete(notify); };
+}
+
+export function useTheme(): Theme {
+  return useSyncExternalStore(subscribe, getTheme, getTheme);
+}
+
+// Mount once in App so system-theme changes also work on the standalone homepage.
+export function useThemeSync() {
+  useLayoutEffect(() => {
+    const media = window.matchMedia(DARK_QUERY);
+    const onSystemChange = () => { if (preference === null) applyTheme(resolveTheme()); };
+    const onStorage = (event: StorageEvent) => {
+      if (event.key !== THEME_KEY && event.key !== null) return;
+      preference = readPreference();
+      applyTheme(resolveTheme());
+    };
+    applyTheme(resolveTheme());
+    media.addEventListener('change', onSystemChange);
+    window.addEventListener('storage', onStorage);
+    return () => {
+      media.removeEventListener('change', onSystemChange);
+      window.removeEventListener('storage', onStorage);
+    };
+  }, []);
+}
