@@ -0,0 +1,37 @@
+"""Explicit creator-session results; a public profile is not proof of access."""
+from __future__ import annotations
+
+import time
+
+import platform_readback
+from profile_lock import ProfileBusyError
+
+DOUYIN_SOURCE = "douyin-creator"
+
+
+def result(status="unknown", *, account=None, error_code="", message=""):
+    account = account or {}
+    account_id = str(account.get("platform_account_id") or "").strip()
+    if status == "verified" and not account_id:
+        status, error_code, message = "unknown", "identity_missing", "后台响应缺少账号身份，暂时无法核验"
+    verified = status == "verified"
+    return {"loggedIn": verified, "verificationStatus": status,
+            "accountId": account_id if verified else None,
+            "checkedAt": int(time.time()), "errorCode": error_code, "message": message,
+            "name": str(account.get("display_name") or "") if verified else "",
+            "avatar": str(account.get("avatar") or "") if verified else ""}
+
+
+def failure(error):
+    if isinstance(error, platform_readback.LoginRequiredError):
+        return result("login_required", error_code="login_required", message="抖音创作者后台未登录，请在账号页重新登录")
+    if isinstance(error, ProfileBusyError):
+        return result(error_code="profile_busy", message=str(error))
+    return result(error_code="verification_failed", message="暂时无法核验抖音创作者后台：" + str(error)[:240])
+
+
+def verify_douyin(page, **request_options):
+    try:
+        return result("verified", account=platform_readback.read_douyin_account(page, **request_options))
+    except Exception as error:
+        return failure(error)
