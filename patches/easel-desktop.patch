+/** Legacy cache deltas have no verified comparison contract and stay hidden. */
+export function canShowGrowth(data: AccountAnalytics, current?: AccountWhoami): boolean {
+  if (data.growthStatus !== 'available' || data.verificationStatus !== 'verified' || typeof data.platform !== 'string' || !data.platform ||
+      typeof data.accountId !== 'string' || !data.accountId.trim() || typeof data.source !== 'string' || !data.source.trim() || data.errorCode) return false;
+  if (current?.verificationStatus === 'verified' && current.accountId && current.accountId !== data.accountId) return false;
+  return true;
+}
+
+export function unavailableGrowthReason(data: AccountAnalytics): string {
+  return data.growthReason || (data.growthStatus === 'available'
+    ? '当前账号与这份历史结果不同；请刷新后查看对应账号的增长。'
+    : '这份结果尚无可核验的账号与来源对比，请刷新；旧无归属记录不作为增长基线。');
+}
