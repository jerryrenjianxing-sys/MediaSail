@@ -0,0 +1,78 @@
+import { useCallback, useEffect, useState } from 'react';
+import { changeLibrary, chooseLibrary, libraryStatus, openLibrary, type LibraryStatus } from '../lib/library';
+import { hasUnsavedEdits } from '../lib/unsaved';
+
+export default function LibrarySettings() {
+  const [status, setStatus] = useState<LibraryStatus | null>(null);
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [proposal, setProposal] = useState<{ targetRoot: string } | null>(null);
+  const refresh = useCallback(async () => {
+    setError('');
+    try { setStatus(await libraryStatus()); }
+    catch (e) { setError(e instanceof Error ? e.message : '无法读取资料库位置。'); }
+  }, []);
+  useEffect(() => { if (window.desktopLibrary) void refresh(); }, [refresh]);
+
+  const select = async () => {
+    if (hasUnsavedEdits()) { setError('还有未保存的编辑或表单，请先保存或取消，再调整资料库。'); return; }
+    setBusy(true); setError('');
+    try {
+      const targetRoot = await chooseLibrary();
+      if (targetRoot) setProposal({ targetRoot });
+    } catch (e) { setError(e instanceof Error ? e.message : '未能选择目录。'); }
+    finally { setBusy(false); }
+  };
+  const confirm = async () => {
+    if (!proposal) return;
+    if (hasUnsavedEdits()) { setError('还有未保存的编辑或表单，请先保存或取消，当前草稿会继续保留。'); return; }
+    setBusy(true); setError('');
+    try { await changeLibrary(proposal.targetRoot); setProposal(null); await refresh(); }
+    catch (e) { setError(e instanceof Error ? e.message : '资料库未能切换，原资料会继续保留。'); }
+    finally { setBusy(false); }
+  };
+
+  return <section className="st-sec active" aria-label="资料库设置">
+    <h3>资料库</h3>
+    <p>画像、内容、素材、分析、日历、方法与工具，以及本软件保存的配置和登录资料，都使用同一个资料库。把当前连接说明交给 Agent，它可以在这里协作。</p>
+    {!window.desktopLibrary ? <p className="foot-note">网页版不能调整本机资料库位置，请在 MediaSail 桌面版设置中操作。</p> : <>
+      {status ? <div className="card" style={{ padding: 14, overflowWrap: 'anywhere' }}>
+        <strong>当前资料库</strong><p style={{ margin: '6px 0 12px', userSelect: 'text' }}>{status.libraryRoot || status.dataRoot}</p>
+        <div className="foot-note">工作区：{status.workspace}</div>
+        <div className="foot-note">运行资料：{status.dataRoot}</div>
+        {!!status.conflicts?.length && <details style={{ marginTop: 12 }}>
+          <summary style={{ cursor: 'pointer' }}>有 {status.conflicts.length} 个工作文件与新版原件需要合并</summary>
+          <p>当前工作文件保留了你的修改。可打开资料库，按以下路径查看工作文件、本地备份和新版原件，再自行比较合并。</p>
+          {status.conflicts.map((conflict, index) => {
+            const isSkill = conflict.scope === 'agent-skill' || conflict.incoming.replace(/\\/g, '/').includes('/upgrade-backups/agent-skill/');
+            const base = isSkill ? `${status.libraryRoot}/agent-skill/mediasail` : status.workspace;
+            const working = conflict.working || `${base}/${conflict.path}`;
+            return <div className="card" key={`${conflict.path}-${index}`} style={{ padding: 12, marginTop: 8, userSelect: 'text' }}>
+              <strong>{conflict.path}</strong>
+              <p>当前工作文件：{working}</p>
+              <p>本地修改备份：{conflict.local}</p>
+              <p>新版原件：{conflict.incoming}</p>
+            </div>;
+          })}
+        </details>}
+      </div> : !error && <p role="status">正在读取资料库位置…</p>}
+      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginTop: 16 }}>
+        <button className="btn" disabled={busy || !status} onClick={() => { setError(''); void openLibrary().catch(e => setError(e instanceof Error ? e.message : '无法打开资料库。')); }}>打开资料库</button>
+        <button className="btn" disabled={busy || !status} onClick={() => void select()}>更换资料库</button>
+        <button className="btn btn-sm" disabled={busy} onClick={() => void refresh()}>刷新位置</button>
+      </div>
+      {proposal && <div className="card" style={{ padding: 14, marginTop: 16, overflowWrap: 'anywhere' }} role="status">
+        <h4 style={{ marginTop: 0 }}>更换资料库</h4>
+        <p>目标目录：<span style={{ userSelect: 'text' }}>{proposal.targetRoot}</span></p>
+        <p>选择空目录会建立新资料库，选择已有的有效资料库会直接打开。旧资料原地保留，不会自动带入新库；新库需要重新配置画像和登录账号。</p>
+        <p>请先保存编辑并结束软件内任务。确认后 MediaSail 会重新启动，以后沿用这个位置；Agent 随后需要重新读取连接资料。</p>
+        <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
+          <button className="btn btn-primary" disabled={busy} onClick={() => void confirm()}>{busy ? '正在核验并准备重启…' : '使用此资料库并重启'}</button>
+          <button className="btn" disabled={busy} onClick={() => setProposal(null)}>取消</button>
+        </div>
+      </div>}
+    </>}
+    {error && <p role="alert" style={{ color: 'var(--red)' }}>{error}</p>}
+    <p className="foot-note">软件程序和运行环境仍在安装目录；卸载软件默认保留资料库。登录资料可能包含敏感信息，请按自己的需求管理目录权限和备份。</p>
+  </section>;
+}
