@@ -0,0 +1,76 @@
+import type { OutputMeta, OutputNode, ProjectMetadata, ProjectMetadataChanges } from './api';
+
+export const CATEGORIES = [
+  { value: 'creation', label: '创作内容' }, { value: 'analysis', label: '分析报告' }, { value: 'reference', label: '参考资料' },
+];
+export const KINDS = [
+  { value: 'article', label: '文档' }, { value: 'xhs-note', label: '图文笔记' }, { value: 'cards', label: '图文卡片' },
+  { value: 'poster', label: '海报' }, { value: 'video', label: '视频' }, { value: 'audio', label: '音频' }, { value: 'other', label: '其他' },
+];
+export const STAGES = [
+  { value: 'draft', label: '草稿' }, { value: 'ready', label: '已就绪' }, { value: 'published', label: '已标记发布' },
+];
+export const SHAPES = [
+  { value: 'graphic', label: '图文' }, { value: 'video', label: '视频' }, { value: 'audio', label: '音频' },
+  { value: 'document', label: '文档' }, { value: 'other', label: '其他形态' }, { value: 'unspecified', label: '未指定形态' },
+];
+export const textValue = (value: unknown): string => typeof value === 'string' ? value : '';
+export const categoryOf = (value: unknown): string => CATEGORIES.some(c => c.value === value) ? String(value) : 'uncategorized';
+export const categoryLabel = (value: unknown): string => CATEGORIES.find(c => c.value === value)?.label || (textValue(value) ? `自定义用途：${value}` : '未分类');
+export const stageLabel = (value: unknown): string => STAGES.find(s => s.value === value)?.label || textValue(value) || '未标记';
+export const kindLabel = (value: unknown): string => KINDS.find(k => k.value === value)?.label || textValue(value) || '未指定形态';
+export function shapeOf(value: unknown): string {
+  if (!textValue(value)) return 'unspecified';
+  if (value === 'article') return 'document';
+  if (['xhs-note', 'cards', 'poster'].includes(String(value))) return 'graphic';
+  return value === 'video' || value === 'audio' ? value : 'other';
+}
+export interface ProjectFilters { query: string; category: string; profile: string; platform: string; shape: string; stage: string; }
+export const EMPTY_PROJECT_FILTERS: ProjectFilters = { query: '', category: 'all', profile: 'all', platform: 'all', shape: 'all', stage: 'all' };
+export function matchesProject(project: OutputNode, filters: ProjectFilters): boolean {
+  const m = project.meta || {};
+  if (filters.category !== 'all' && categoryOf(m.category) !== filters.category) return false;
+  if (filters.profile !== 'all' && textValue(m.profile) !== filters.profile) return false;
+  if (filters.platform !== 'all' && textValue(m.platform) !== filters.platform) return false;
+  if (filters.shape !== 'all' && shapeOf(m.kind) !== filters.shape) return false;
+  if (filters.stage !== 'all' && textValue(m.status) !== filters.stage) return false;
+  const query = filters.query.trim().toLocaleLowerCase();
+  if (!query) return true;
+  const tags = Array.isArray(m.tags) ? m.tags.filter(t => typeof t === 'string') : [];
+  return [project.name, textValue(m.title), textValue(m.summary), ...tags].join('\n').toLocaleLowerCase().includes(query);
+}
+export function valuesFor(projects: OutputNode[], key: keyof OutputMeta): string[] {
+  return [...new Set(projects.map(p => textValue(p.meta?.[key])))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
+}
+
+const FIELDS = ['title', 'summary', 'category', 'kind', 'status', 'profile', 'platform', 'tags'] as const;
+export type MetadataDraft = Record<Exclude<typeof FIELDS[number], 'tags'>, string> & { tags: string };
+export function draftFrom(metadata: ProjectMetadata): MetadataDraft {
+  return {
+    title: textValue(metadata.title), summary: textValue(metadata.summary), category: textValue(metadata.category),
+    kind: textValue(metadata.kind), status: textValue(metadata.status), profile: textValue(metadata.profile), platform: textValue(metadata.platform),
+    tags: Array.isArray(metadata.tags) ? metadata.tags.filter(t => typeof t === 'string').join('，') : '',
+  };
+}
+export function metadataDelta(original: MetadataDraft, draft: MetadataDraft): ProjectMetadataChanges {
+  const delta: ProjectMetadataChanges = {};
+  for (const key of FIELDS) {
+    if (draft[key] === original[key]) continue;
+    if (key === 'tags') delta.tags = [...new Set(draft.tags.split(/[,，\n]/).map(t => t.trim()).filter(Boolean))];
+    else delta[key] = draft[key];
+  }
+  return delta;
+}
+
+let readProjectEdits: (() => boolean) | null = null;
+let readProjectSaving: (() => boolean) | null = null;
+let closingApproved = false;
+export function registerProjectEdits(read: () => boolean, saving: () => boolean = () => false): () => void {
+  readProjectEdits = read; readProjectSaving = saving; closingApproved = false;
+  return () => { if (readProjectEdits === read) { readProjectEdits = null; readProjectSaving = null; closingApproved = false; } };
+}
+export function hasUnsavedProjectMetadata(): boolean { return Boolean(readProjectEdits?.()); }
+export function isProjectMetadataSaving(): boolean { return Boolean(readProjectSaving?.()); }
+export function projectCloseApproved(): boolean { return closingApproved; }
+export function approveProjectClose(): void { closingApproved = true; }
+export function resetProjectCloseApproval(): void { closingApproved = false; }
