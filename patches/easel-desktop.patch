+        <label className="metadata-field">画像<input className="field" aria-label="画像" list="metadata-profile-options" value={draft.profile} disabled={saving} onChange={e => change('profile', e.target.value)} /><datalist id="metadata-profile-options">{[...new Set([...profiles, ...knownProfiles])].filter(Boolean).map(value => <option key={value} value={value} />)}</datalist></label>
+        <label className="metadata-field">平台<input className="field" aria-label="平台" list="metadata-platform-options" value={draft.platform} disabled={saving} onChange={e => change('platform', e.target.value)} /><datalist id="metadata-platform-options">{platforms.filter(Boolean).map(value => <option key={value} value={value} />)}</datalist></label>
