+/* Skill landing: isolated from the management workspace. */
+.skill-home {
+  --sh-bg: #fafaf9;
+  --sh-text: #171918;
+  --sh-muted: #646965;
+  --sh-line: #e1e4e0;
+  --sh-accent: #704bd8;
