+@app.get("/api/projects/{project}/metadata")
+def api_project_metadata(project: str):
+    try:
+        return project_manifest.metadata_snapshot(_project_metadata_file(project))
+    except (OSError, project_manifest.ManifestError) as error:
+        _metadata_error(error)
+
+
+@app.patch("/api/projects/{project}/metadata")
+def api_project_metadata_patch(project: str, req: ProjectMetadataPatch):
+    # Synchronous endpoint: file locking and fsync run in FastAPI's worker pool.
