+  border: 1px solid var(--sh-line);
+  border-radius: 50%;
+  color: var(--sh-muted);
+  transition: color 150ms ease, border-color 150ms ease;
+}
+.skill-theme:hover {
+  color: var(--sh-text);
+  border-color: var(--sh-accent);
+}
+.skill-theme-icon {
