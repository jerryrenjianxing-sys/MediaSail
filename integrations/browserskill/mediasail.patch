+pub(super) fn launch_managed(exe: &Path, args: &[OsString], log: &Path) -> Result<serde_json::Value> {
+    let command = command_line(std::iter::once(exe.as_os_str()).chain(args.iter().map(|a| a.as_os_str())));
+    let environment: Vec<_> = std::env::vars_os().collect();
+    let input = File::open("NUL")?;
+    let output = File::options().append(true).create(true).open(log)?;
+    let mut child = windows_process::spawn(
+        exe.as_os_str(), &command, &environment, [&input, &output, &output],
+        DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP | CREATE_BREAKAWAY_FROM_JOB | CREATE_SUSPENDED,
+    ).map_err(|error| spawn_failure(error, exe))?;
+    let verified = child.outside_job();
+    if !matches!(verified, Ok(true)) {
+        let _ = child.kill(); let _ = child.wait();
+        anyhow::bail!("MediaSail browser could not leave the caller's Job; no browser was started");
+    }
+    if let Err(error) = child.resume() {
+        let _ = child.kill(); let _ = child.wait();
+        return Err(error.into());
+    }
+    Ok(serde_json::json!({"ok":true,"pid":child.id(),"independent":true}))
+}
+
